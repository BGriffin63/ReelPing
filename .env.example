# ReelPing example environment file.
#
# Copy to .env and adjust. Compose reads it automatically.
#
# IMPORTANT: Do NOT put the Plex token or Discord webhook here. Secrets are
# entered in the authenticated ReelPing web UI, never via environment variables.

# Container time zone (also selectable in the UI). e.g. America/New_York
TZ=UTC

# Host port to publish the web UI on (container listens on 8080).
REELPING_HOST_PORT=8787

# Listen address inside the container (rarely changed).
RP_ADDR=:8080

# Config directory inside the container (persisted volume).
RP_CONFIG_DIR=/config
